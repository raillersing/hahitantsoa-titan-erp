#!/bin/bash
# =============================================================================
# erp-pdf2html — Convert a PDF to pixel-perfect HTML using pdf2htmlEX
# =============================================================================
# Usage:
#   bash scripts/dev/erp-pdf2html --input <pdf_file> --output <html_dir>
#
# Options:
#   --input <path>     PDF source file (required)
#   --output <dir>     Output directory for HTML files (default: same as PDF)
#   --mode <mode>     fidelity | template  (default: fidelity)
#   --embed-* 1        Embed CSS/fonts/images/JS inline (self-contained)
#   --help             Show this help
#
# The script auto-detects the pdf2htmlEX binary installed by
# scripts/dev/erp-install-pdf2htmlex.
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
TOOLS_DIR="$PROJECT_DIR/.tools/pdf2htmlex"
PDF2HTML_BIN="$TOOLS_DIR/pdf2htmlEX"

# Defaults
INPUT=""
OUTPUT=""
MODE="fidelity"

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --input)
            INPUT="$2"
            shift 2
            ;;
        --output)
            OUTPUT="$2"
            shift 2
            ;;
        --mode)
            MODE="$2"
            shift 2
            ;;
        --help|-h)
            sed -n '/^#/p' "$0" | sed 's/^# //;s/^#//'
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage."
            exit 1
            ;;
    esac
done

# ---------------------------------------------------------------------------
# Validate
# ---------------------------------------------------------------------------
if [ -z "$INPUT" ]; then
    echo "❌ ERROR: --input is required."
    echo "   Use --help for usage."
    exit 1
fi

if [ ! -f "$INPUT" ]; then
    echo "❌ ERROR: Input file not found: $INPUT"
    exit 1
fi

INPUT_ABS="$(cd "$(dirname "$INPUT")" && pwd)/$(basename "$INPUT")"

if [ -z "$OUTPUT" ]; then
    OUTPUT="$(dirname "$INPUT_ABS")/pdf2html_output"
fi

mkdir -p "$OUTPUT"
OUTPUT_ABS="$(cd "$OUTPUT" && pwd)"

# ---------------------------------------------------------------------------
# Locate pdf2htmlEX
# ---------------------------------------------------------------------------
if [ ! -f "$PDF2HTML_BIN" ] || [ ! -x "$PDF2HTML_BIN" ]; then
    echo "⚠️  pdf2htmlEX not found at $PDF2HTML_BIN"
    echo "   Running installer first..."
    bash "$SCRIPT_DIR/erp-install-pdf2htmlex"
fi

if [ ! -f "$PDF2HTML_BIN" ] || [ ! -x "$PDF2HTML_BIN" ]; then
    echo "❌ ERROR: pdf2htmlEX installation failed. Cannot continue."
    exit 1
fi

echo "=== ERP PDF → HTML Conversion ==="
echo "Binary: $PDF2HTML_BIN"
echo "Input:  $INPUT_ABS"
echo "Output: $OUTPUT_ABS"
echo "Mode:   $MODE"
echo ""

# ---------------------------------------------------------------------------
# Detect if we need --data-dir (extracted AppImage case)
# ---------------------------------------------------------------------------
DATA_DIR_FLAG=""
EXTRACTED_DATA="$TOOLS_DIR/squashfs-root/usr/local/share/pdf2htmlEX"
if [ -d "$EXTRACTED_DATA" ] && [ -f "$EXTRACTED_DATA/manifest" ]; then
    DATA_DIR_FLAG="--data-dir $EXTRACTED_DATA"
fi

# ---------------------------------------------------------------------------
# Build pdf2htmlEX flags
# ---------------------------------------------------------------------------
# --zoom 1.3              : larger render to avoid browser rounding, then scale down
# --font-size-multiplier 1: preserve exact font sizes
# --process-outline 0     : disable TOC (not needed for templates)
# --embed-* 1             : embed CSS, fonts, images, JS inline (self-contained HTML)
# --bg-format svg         : vector background (smaller than PNG)
# --dest-dir              : output directory
# --page-filename         : naming pattern for multi-page output

FLAGS=(
    --zoom 1.3
    --font-size-multiplier 1
    --process-outline 0
    --embed-css 1
    --embed-font 1
    --embed-image 1
    --embed-javascript 1
    --bg-format svg
    --dest-dir "$OUTPUT_ABS"
    --page-filename "%s-%03d.html"
    $DATA_DIR_FLAG
)

echo "Flags: ${FLAGS[*]}"
echo ""

# ---------------------------------------------------------------------------
# Run conversion
# ---------------------------------------------------------------------------
echo "Running conversion..."
"$PDF2HTML_BIN" "${FLAGS[@]}" "$INPUT_ABS"

# ---------------------------------------------------------------------------
# Report results
# ---------------------------------------------------------------------------
echo ""
echo "=== Conversion complete ==="
echo "Output directory: $OUTPUT_ABS"
echo "Generated files:"
ls -lh "$OUTPUT_ABS" | tail -n +2

echo ""
echo "Next steps:"
echo "  1. Open the HTML in a browser to verify visual fidelity."
echo "  2. If satisfied, run post-processing to create a Jinja template:"
echo "     bash scripts/dev/erp-pdf2html-postprocess --input <html_file> --output <template.html>"
