#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
COMPOSE_FILE="$REPO_ROOT/compose.agent-ci.yaml"
# A stable project per worktree keeps Compose volumes and Django's test database
# isolated when several agents validate backend changes concurrently.
WORKTREE_FINGERPRINT="$(printf '%s' "$REPO_ROOT" | sha256sum | cut -c1-12)"
INSTANCE_NAME="${ERP_AGENT_CI_INSTANCE:-default}"
if ! [[ "$INSTANCE_NAME" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "ERROR: ERP_AGENT_CI_INSTANCE must contain only letters, digits, underscores, or hyphens." >&2
  exit 2
fi
BACKEND_PORT="${ERP_AGENT_BACKEND_PORT:-8000}"
if ! [[ "$BACKEND_PORT" =~ ^[0-9]+$ ]] || [ "$BACKEND_PORT" -lt 1024 ] || [ "$BACKEND_PORT" -gt 65535 ]; then
  echo "ERROR: ERP_AGENT_BACKEND_PORT must be a TCP port between 1024 and 65535." >&2
  exit 2
fi
DJANGO_DEBUG_VALUE="${ERP_AGENT_DJANGO_DEBUG:-0}"
if [ "$DJANGO_DEBUG_VALUE" != "0" ] && [ "$DJANGO_DEBUG_VALUE" != "1" ]; then
  echo "ERROR: ERP_AGENT_DJANGO_DEBUG must be 0 or 1." >&2
  exit 2
fi
export ERP_AGENT_BACKEND_PORT="$BACKEND_PORT"
export ERP_AGENT_DJANGO_DEBUG="$DJANGO_DEBUG_VALUE"
INSTANCE_FINGERPRINT="$(printf '%s' "$INSTANCE_NAME" | sha256sum | cut -c1-8)"
COMPOSE_PROJECT="hahitantsoa_titan_erp_agent_ci_${WORKTREE_FINGERPRINT}_${INSTANCE_FINGERPRINT}"
# Share the dependency image across worktrees while keeping their containers,
# networks, and database volumes isolated by COMPOSE_PROJECT.
BACKEND_IMAGE_FINGERPRINT="$(
  cd "$REPO_ROOT"
  sha256sum backend/Dockerfile pyproject.toml | sha256sum | cut -c1-12
)"
export ERP_AGENT_BACKEND_IMAGE="hahitantsoa_titan_erp_agent_ci_backend:${BACKEND_IMAGE_FINGERPRINT}"

cd "$REPO_ROOT"

print_usage() {
  cat <<'USAGE'
Usage:
  scripts/dev/erp-backend-compose-ci <docker compose args...>

Purpose:
  Run backend-local Docker Compose validation without reading, sourcing, copying
  or requiring any .env file.

Examples:
  scripts/dev/erp-backend-compose-ci config --quiet
  scripts/dev/erp-backend-compose-ci config --services
  scripts/dev/erp-backend-compose-ci up -d db redis backend
  scripts/dev/erp-backend-compose-ci exec -T backend python backend/manage.py check
  scripts/dev/erp-backend-compose-ci run --rm backend python -m ruff check backend tests

Notes:
  This wrapper always uses compose.agent-ci.yaml.
  Backend images are shared across worktrees when their Dockerfile and Python
  dependency manifest are identical.
  ERP_AGENT_CI_INSTANCE may select an additional isolated Compose project inside
  one worktree, for example when local test shards run concurrently.
  ERP_AGENT_BACKEND_PORT may select the loopback host port for the backend
  service; it defaults to 8000. ERP_AGENT_DJANGO_DEBUG accepts only 0 or 1.
  It injects only versioned non-secret CI/dev values.
  It is intended for agent-safe local backend validation.
USAGE
}

if [ ! -f "$COMPOSE_FILE" ]; then
  echo "ERROR: missing compose file: $COMPOSE_FILE"
  exit 1
fi

if [ "$#" -eq 0 ]; then
  print_usage
  exit 2
fi

case "${1:-}" in
  help|--help|-h)
    print_usage
    exit 0
    ;;
esac

exec docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" "$@"
