POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-password

CLIENT_APP_PORT=5173

# Used only by the bootstrap-admin script; do not commit the actual value.
