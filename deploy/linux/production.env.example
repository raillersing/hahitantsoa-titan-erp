# Copy this file to production.env on the Linux server. Never commit production.env.
PUBLIC_FQDN=erp.example.com

DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=erp.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_TRUST_X_FORWARDED_PROTO=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

POSTGRES_DB=hahitantsoa_titan
POSTGRES_USER=hahitantsoa_titan
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
